<Controls:MetroWindow  x:Class="WebpageScreenshotTaker.UI.Views.NewScreenshotDetailsView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:Controls="clr-namespace:MahApps.Metro.Controls;assembly=MahApps.Metro"
        xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        mc:Ignorable="d"
        FontSize="14"
        BorderThickness="1"
        ShowIconOnTitleBar="False"
        Height="450" Width="800"
        MinHeight="324" MinWidth="400"
        Loaded="MetroWindow_Loaded"
        Title="ADD New Screenshot Details">

    <Controls:MetroWindow.Resources>

        <Style TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Bottom"/>
        </Style>
    </Controls:MetroWindow.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height=".8*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height=".8*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height=".8*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height=".8*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="40"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="50"/>
        </Grid.ColumnDefinitions>

        <TextBlock Text="Directory" Grid.Row="0"/>

        <!--Directory to save the image into-->
        <TextBox x:Name="tbDirectory"
            Controls:TextBoxHelper.Watermark="Choose a directory to save the image into" Grid.Row="1" Grid.Column="0" 
                 VerticalContentAlignment="Center" 
                 IsReadOnly="True"/>

        <!--Button to change the directory path-->
        <Button x:Name="BtnChangeDirectory" Grid.Row="1" Grid.Column="1" 
                    VerticalContentAlignment="Center" 
                    Content="---"
                Click="BtnChangeDirectory_Click"
                />
     
        <TextBlock Text="Time of the day to take the image" Grid.Row="2"/>
        <!--Time of day to take the image.-->
        <xctk:DateTimeUpDown x:Name="tbTime" Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2"
                             VerticalContentAlignment="Center" 
                             TextAlignment="Left" ShowButtonSpinner="False"
                             Format="ShortTime"
                             Kind="Local">
            <xctk:DateTimeUpDown.Style>
                <Style TargetType="xctk:DateTimeUpDown">
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="BorderBrush" Value="#7F7F7F" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="False">
                            <Setter Property="BorderBrush" Value="#CCCCCC" />
                        </Trigger>
                        <Trigger Property="IsFocused" Value="True">
                            <Setter Property="BorderBrush" Value="#000000" />
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </xctk:DateTimeUpDown.Style>

        </xctk:DateTimeUpDown>


        <TextBlock Text="Image Name" Grid.Row="4"/>
        <!--Name of the image-->
        <TextBox x:Name="tbImageName" Controls:TextBoxHelper.Watermark="Name of the image"
            Grid.Row="5" Grid.Column="0"  Grid.ColumnSpan="2"
                            VerticalContentAlignment="Center"
                            />


        <TextBlock Text="URL" Grid.Row="6"/>
        <!--Url of the image-->
        <TextBox x:Name="tbUrl" Controls:TextBoxHelper.Watermark="URL of the image"
            Grid.Row="7" Grid.Column="0"  Grid.ColumnSpan="2"
                             VerticalContentAlignment="Center" Margin="1"/>

        <StackPanel Grid.Row="8" Grid.Column="0" Grid.ColumnSpan="2"
            Orientation="Horizontal" HorizontalAlignment="Center" Margin="5">
            <!--Submit Button-->
            <Button x:Name="AddButton" IsDefault="True" Width="60" Margin="0 0 2.5 0" 
                    Padding="5" Content="ADD" Foreground="Black" Background="#eee" 
                    Click="AddButton_Click"/>
            <!--Cancel Button-->
            <Button x:Name="CancelButton" IsCancel="True" Width="60" Margin="2.5 0 0 0" 
                    Padding="5" Content="Cancel" Foreground="Black" Background="#eee"/>
        </StackPanel>

    </Grid>
</Controls:MetroWindow>
